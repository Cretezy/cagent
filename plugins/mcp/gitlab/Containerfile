ARG GITLAB_MCP_VERSION=v2.1.53

FROM node:22.21.1-alpine AS build
ARG GITLAB_MCP_VERSION
RUN apk add --no-cache git
WORKDIR /src
RUN git clone --depth 1 --branch "${GITLAB_MCP_VERSION}" \
      https://github.com/zereight/gitlab-mcp.git . \
    && test "$(git describe --tags --exact-match)" = "${GITLAB_MCP_VERSION}"
RUN npm ci --ignore-scripts \
    && npm run build \
    && npm prune --omit=dev --ignore-scripts

FROM node:22.21.1-alpine
LABEL org.opencontainers.image.source="https://github.com/Cretezy/cagent"
LABEL org.opencontainers.image.description="GitLab MCP Server for Cagent"
LABEL io.modelcontextprotocol.server.name="io.github.zereight/gitlab-mcp"
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /src/build ./build
COPY --from=build --chown=node:node /src/node_modules ./node_modules
COPY --from=build --chown=node:node /src/package.json ./package.json
USER node
CMD ["node", "/app/build/index.js"]
